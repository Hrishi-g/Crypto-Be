<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />
    
    <property name="LOG_FILE" value="logs/application.log" />

    <!-- Console Appender with custom pattern including Trace ID -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{CRYPTX_uniqueId}] %logger{36} : %msg%n</pattern>
            <charset>utf8</charset>
        </encoder>
    </appender>

    <!-- File Appender -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{CRYPTX_uniqueId}] %logger{36} : %msg%n</pattern>
            <charset>utf8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/archived/application-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>36500</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- App log levels -->
    <logger name="org.springframework" level="WARN" />
    <logger name="org.springframework.security" level="DEBUG" />
    <logger name="org.hibernate" level="WARN" />
    <logger name="com.project.cryptx" level="INFO" />
    <logger name="org.springframework.web.reactive.function.client.ExchangeFunctions" level="TRACE" />
    <logger name="io.micrometer.core.instrument.binder.cache.CaffeineCacheMetrics" level="ERROR" />

    <!-- LOCAL Profile: Only log to File (disables console output) -->
    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="FILE" />
        </root>
    </springProfile>

    <!-- PRODUCTION (Render) Profile: Log to Console so Render can capture it -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
    </springProfile>
</configuration>
